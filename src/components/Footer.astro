---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="site-footer container">
	<div>
		<a class="footer-brand" href={`${base}/`}>
			VoidSpace0x<span class="brand-dot">.</span>
		</a>
		<p>공허를 떠도는 기록들.</p>
	</div>
	<div class="footer-right">
		<div class="footer-links">
			<a
				href="https://github.com/VoidSpace0x"
				target="_blank"
				rel="noopener noreferrer"
			>
				GitHub ↗<span class="sr-only"> (새 탭)</span>
			</a>
			<a href={`${base}/rss.xml`}>RSS ↗</a>
		</div>
		<small>© {new Date().getFullYear()} VoidSpace0x</small>
	</div>
</footer>
