---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PostCard from '../../components/PostCard.astro';
import { CATEGORY_LABELS, SITE_TITLE, type Category } from '../../consts';

export async function getStaticPaths() {
	return (Object.keys(CATEGORY_LABELS) as Category[]).map((category) => ({
		params: { category },
	}));
}

const { category } = Astro.params as { category: Category };
const posts = (
	await getCollection(
		'blog',
		({ data }) => data.category === category && (import.meta.env.PROD ? !data.draft : true),
	)
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const label = CATEGORY_LABELS[category];
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`${label} | ${SITE_TITLE}`} description={`${label} 카테고리 글 목록`} />
	</head>
	<body>
		<Header />
		<main>
			<h1>{label}</h1>
			{posts.length === 0 && <p>아직 글이 없습니다.</p>}
			<ul class="post-list">
				{posts.map((post) => <PostCard post={post} />)}
			</ul>
		</main>
		<Footer />
		<style>
			.post-list {
				list-style: none;
				margin: 0;
				padding: 0;
				display: flex;
				flex-direction: column;
				gap: 1em;
			}
		</style>
	</body>
</html>
