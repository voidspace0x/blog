---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import { CATEGORY_LABELS } from '../consts';
interface Props {
	post: CollectionEntry<'blog'>;
	heading?: 'h2' | 'h3';
}
const { post, heading: Heading = 'h2' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<li class="post-card" data-category={post.data.category}>
	<a href={`${base}/blog/${post.id}/`}>
		<div class="post-meta">
			<span class="category-badge">{CATEGORY_LABELS[post.data.category]}</span>
			<span class="meta-dot" aria-hidden="true">
				·
			</span>
			<FormattedDate date={post.data.pubDate} />
			{post.data.draft && <span class="draft-badge">초안</span>}
		</div>
		<Heading class="post-title">{post.data.title}</Heading>
		<p class="post-description">{post.data.description}</p>
		<span class="post-arrow" aria-hidden="true">
			↗
		</span>
	</a>
</li>
