---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PostCard from '../../components/PostCard.astro';
import CategoryNav from '../../components/CategoryNav.astro';
import { getPosts } from '../../lib/posts';
const posts = await getPosts();
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead
			title="전체 글 | VoidSpace0x"
			description="개발, 시장, 일상을 기록합니다."
		/>
	</head>
	<body>
		<Header />
		<main id="main-content" tabindex="-1" class="container listing-page">
			<div class="page-heading">
				<p class="eyebrow">THE ARCHIVE</p>
				<h1>
					전체 글<span class="heading-dot">.</span>
				</h1>
				<p>개발, 시장, 일상을 기록합니다.</p>
			</div>
			<CategoryNav posts={posts} />
			<ul class="post-list">
				{posts.map((post) => (
					<PostCard post={post} />
				))}
			</ul>
			{posts.length === 0 && <p class="empty-state">아직 기록이 없습니다.</p>}
		</main>
		<Footer />
	</body>
</html>
