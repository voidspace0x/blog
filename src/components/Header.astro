---
import HeaderLink from './HeaderLink.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<a class="skip-link" href="#main-content">
	본문 바로가기
</a>
<header class="site-header">
	<nav class="container header-inner" aria-label="주 메뉴">
		<a class="brand" href={`${base}/`}>
			<span class="orbit-mark" aria-hidden="true">
				<span class="planet"></span>
			</span>
			VoidSpace0x<span class="brand-dot">.</span>
		</a>
		<div class="internal-links">
			<HeaderLink href="/">홈</HeaderLink>
			<HeaderLink href="/blog">전체 글</HeaderLink>
			<HeaderLink href="/about">소개</HeaderLink>
		</div>
		<a
			class="github-link"
			href="https://github.com/VoidSpace0x"
			target="_blank"
			rel="noopener noreferrer"
		>
			GitHub <span aria-hidden="true">↗</span>
			<span class="sr-only"> (새 탭)</span>
		</a>
	</nav>
</header>
