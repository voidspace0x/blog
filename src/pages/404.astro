---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title="404 | VoidSpace0x" description="페이지를 찾을 수 없습니다" />
	</head>
	<body>
		<Header />
		<main class="not-found">
			<h1>404</h1>
			<p>이 페이지는 공허 속으로 사라졌습니다.</p>
			<a href={import.meta.env.BASE_URL}>홈으로 돌아가기</a>
		</main>
		<Footer />
		<style>
			.not-found {
				text-align: center;
				padding: 4em 1em;
			}
			.not-found h1 {
				font-size: 4em;
				color: var(--accent);
			}
		</style>
	</body>
</html>
