---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead
			title="글쓰기 | VoidSpace0x"
			description="VoidSpace0x 블로그 글쓰기"
		/>
		<meta name="robots" content="noindex, nofollow" />
		<meta
			http-equiv="Content-Security-Policy"
			content="default-src 'self'; script-src 'self'; connect-src 'self'; img-src 'self' https: data: blob:; style-src 'self' https://cdn.jsdelivr.net; font-src 'self' https://cdn.jsdelivr.net; object-src 'none'; base-uri 'self'; form-action 'none'"
		/>
	</head>
	<body>
		<Header />
		<main id="main-content" tabindex="-1" class="container editor-page">
			<div class="editor-heading">
				<div>
					<p class="eyebrow">NEW RECORD</p>
					<h1>
						새 글 쓰기<span class="heading-dot">.</span>
					</h1>
					<p>글을 작성하고 미리 본 뒤 Markdown 파일로 내려받으세요.</p>
				</div>
				<a href={`${base}/blog/`} class="text-link">
					전체 글 보기 →
				</a>
			</div>
			<form id="post-form" class="editor-layout">
				<section class="draft-manager" aria-label="내 글 관리">
					<div class="draft-picker">
						<label for="draft-list">내 글</label>
						<select id="draft-list" aria-label="저장된 글 선택"></select>
					</div>
					<div class="draft-actions">
						<button type="button" id="new-post">새 글</button>
						<button type="button" id="import-post">Markdown 불러오기</button>
						<input id="import-file" type="file" accept=".md,.markdown,text/markdown,text/plain" hidden />
						<button type="button" id="delete-post" class="delete-button">현재 글 삭제</button>
					</div>
					<p id="save-status" role="status" aria-live="polite">저장 상태 확인 중…</p>
				</section>
				<div class="editor-fields">
					<div class="field-grid">
						<label>
							제목{' '}
							<input
								id="title"
								name="title"
								type="text"
								maxlength="160"
								required
								placeholder="글 제목"
							/>
						</label>
						<div class="filename-field">
							<span>저장 파일 이름</span>
							<output id="filename-preview" aria-live="polite">
								YYYY-MM-DD-HHmm-제목.md
							</output>
						</div>
					</div>
					<label>
						요약{' '}
						<input
							id="description"
							name="description"
							type="text"
							maxlength="300"
							required
							placeholder="목록에 표시할 한두 문장"
						/>
					</label>
					<div class="field-grid">
						<label>
							카테고리{' '}
							<select id="category" name="category">
								<option value="chat">잡담</option>
								<option value="dev">개발</option>
								<option value="stock">주식</option>
							</select>
						</label>
						<label>
							게시일 <input id="pubDate" name="pubDate" type="date" required />
						</label>
					</div>
					<label class="body-label" for="body">
						본문 <span class="field-hint">Markdown</span>
					</label>
					<div class="body-toolbar">
						<button type="button" id="insert-image">그림 삽입</button>
						<input id="image-file" type="file" accept="image/*" hidden />
						<span>커서 위치에 그림을 넣습니다.</span>
					</div>
					<textarea
						id="body"
						name="body"
						rows="20"
						required
						placeholder="## 첫 번째 이야기&#10;&#10;여기에 글을 써 주세요."
					></textarea>
					<p class="editor-tip">
						파일 이름은 첫 다운로드 때 한국 날짜·시간과 제목으로 정해지고 이후 유지됩니다. 글은
						이 브라우저에 자동 저장됩니다. 그림 파일은 글 파일과 별도로 GitHub에 업로드해야 합니다.
					</p>
				</div>
				<aside class="editor-preview" aria-label="글 미리보기">
					<div class="preview-header">
						<strong>미리보기</strong>
						<span>PREVIEW</span>
					</div>
					<article id="preview-article" data-category="chat">
						<p id="preview-category" class="category-badge">
							잡담
						</p>
						<h2 id="preview-title">제목을 입력해 주세요</h2>
						<p id="preview-description" class="preview-description">
							요약이 여기에 표시됩니다.
						</p>
						<div id="preview-body" class="prose">
							본문을 입력하면 미리보기가 표시됩니다.
						</div>
					</article>
				</aside>
				<div class="editor-publish">
					<div class="publish-copy">
						<label for="draft" class="draft-option">
							<input id="draft" name="draft" type="checkbox" /> 업로드 후 블로그에서 숨기기
						</label>
						<p>체크하면 파일에 <code>draft: true</code>가 들어가며, GitHub에 업로드해도 블로그에 표시되지 않습니다.</p>
					</div>
					<div class="publish-actions">
						<button type="button" id="download" class="button">
							Markdown 파일 다운로드
						</button>
					</div>
				</div>
				<section class="upload-guide" aria-label="GitHub 업로드 방법">
					<strong>블로그에 올리는 방법</strong>
					<ol>
						<li>그림을 넣었다면 <a href="https://github.com/voidspace0x/blog/upload/main/public/images" target="_blank" rel="noopener noreferrer">GitHub 그림 업로드 화면 ↗</a>에 선택한 원본 그림 파일을 먼저 올립니다.</li>
						<li>위 버튼으로 <code>.md</code> 파일을 다운로드합니다.</li>
						<li>
							<a href="https://github.com/voidspace0x/blog/upload/main/src/content/blog" target="_blank" rel="noopener noreferrer">GitHub 글 업로드 화면 열기 ↗</a>에서 다운로드한 파일을 선택합니다. GitHub 로그인이 필요합니다.
						</li>
						<li><strong>Commit changes</strong>를 누르면 저장됩니다. 공개 글은 배포가 끝난 뒤 블로그에 나타납니다.</li>
					</ol>
					<div id="image-upload-list" class="image-upload-list" hidden>
						<strong>이 글에 선택한 그림 파일</strong>
						<ul id="image-file-list"></ul>
						<p>원본 그림 파일을 위 그림 업로드 화면에 같은 이름으로 올려주세요. 업로드 전 그림 미리보기는 이 탭을 닫으면 사라집니다.</p>
					</div>
				</section>
				<p
					id="editor-status"
					class="editor-status"
					role="status"
					aria-live="polite"
				></p>
			</form>
		</main>
		<Footer />
		<script>
			import { marked } from 'marked';
			import DOMPurify from 'dompurify';
			import { makeFilename, makeImageMarkdown, parsePost, serializePost } from '../lib/editor.mjs';
			import { CATEGORY_LABELS } from '../consts';

			const get = (id: string) => document.getElementById(id) as HTMLElement;
			const form = get('post-form') as HTMLFormElement;
			const draft = get('draft') as HTMLInputElement;
			const list = get('draft-list') as HTMLSelectElement;
			const fileInput = get('import-file') as HTMLInputElement;
			const imageInput = get('image-file') as HTMLInputElement;
			const bodyField = get('body') as HTMLTextAreaElement;
			const saveStatus = get('save-status');
			const status = get('editor-status');
			const storageKey = 'voidspace0x-blog-editor-workspace-v2';
			const oldStorageKey = 'voidspace0x-blog-editor-draft-v1';
			type Post = {
				title: string; description: string; category: string; pubDate: string;
				body: string; draft: boolean; extraFrontmatter?: Record<string, unknown>;
			};
			type Draft = { id: string; post: Post; filename: string | null; updatedAt: string; imageFiles?: string[] };
			type Workspace = { activeId: string; drafts: Draft[] };
			let workspace: Workspace;
			let saveTimer: ReturnType<typeof setTimeout> | undefined;
			let loading = false;
			const imagePreviews = new Map<string, Map<string, string>>();

			function today() {
				return new Intl.DateTimeFormat('en-CA', {
					timeZone: 'Asia/Seoul', year: 'numeric', month: '2-digit', day: '2-digit',
				}).format(new Date());
			}
			function emptyPost(): Post {
				return { title: '', description: '', category: 'chat', pubDate: today(), body: '', draft: false };
			}
			function newDraft(post = emptyPost(), filename: string | null = null): Draft {
				return { id: crypto.randomUUID(), post, filename, updatedAt: new Date().toISOString(), imageFiles: [] };
			}
			function currentDraft() {
				return workspace.drafts.find((item) => item.id === workspace.activeId)!;
			}
			function readPost(): Post {
				const data = new FormData(form);
				return {
					title: String(data.get('title') ?? ''),
					description: String(data.get('description') ?? ''),
					category: String(data.get('category') ?? ''),
					pubDate: String(data.get('pubDate') ?? ''),
					body: String(data.get('body') ?? ''),
					draft: draft.checked,
					extraFrontmatter: currentDraft().post.extraFrontmatter,
				};
			}
			function renderList() {
				list.replaceChildren(...workspace.drafts
					.slice().sort((a, b) => b.updatedAt.localeCompare(a.updatedAt))
					.map((item) => {
						const option = new Option(item.post.title.trim() || '제목 없는 글', item.id);
						return option;
					}));
				list.value = workspace.activeId;
			}
			function renderImageList() {
				const files = currentDraft().imageFiles || [];
				get('image-upload-list').hidden = files.length === 0;
				get('image-file-list').replaceChildren(...files.map((name) => {
					const item = document.createElement('li');
					item.textContent = name;
					return item;
				}));
			}
			function preview() {
				const post = readPost();
				try {
					get('filename-preview').textContent = currentDraft().filename || makeFilename(post.title || '제목');
				} catch {
					get('filename-preview').textContent = '제목에 글자나 숫자를 입력해 주세요.';
				}
				get('preview-title').textContent = post.title || '제목을 입력해 주세요';
				get('preview-description').textContent = post.description || '요약이 여기에 표시됩니다.';
				get('preview-category').textContent = CATEGORY_LABELS[post.category as keyof typeof CATEGORY_LABELS] || '잡담';
				get('preview-article').dataset.category = post.category;
				const html = marked.parse(post.body || '본문을 입력하면 미리보기가 표시됩니다.', { async: false }) as string;
				get('preview-body').innerHTML = DOMPurify.sanitize(html, { FORBID_TAGS: ['iframe', 'form', 'style'] });
				const localImages = imagePreviews.get(workspace.activeId);
				get('preview-body').querySelectorAll('img').forEach((img) => {
					const path = new URL(img.getAttribute('src') || '', location.href).pathname;
					const localUrl = localImages?.get(path);
					if (localUrl) img.src = localUrl;
				});
				get('preview-body').querySelectorAll('a').forEach((link) => {
					link.target = '_blank'; link.rel = 'noopener noreferrer';
				});
			}
			function showDraft(item: Draft) {
				loading = true;
				for (const key of ['title', 'description', 'category', 'pubDate', 'body'] as const) {
					const field = form.elements.namedItem(key) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement;
					field.value = item.post[key] || (key === 'pubDate' ? today() : '');
				}
				draft.checked = Boolean(item.post.draft);
				workspace.activeId = item.id;
				renderList();
				renderImageList();
				preview();
				loading = false;
			}
			function persist() {
				try {
					localStorage.setItem(storageKey, JSON.stringify(workspace));
					const time = new Intl.DateTimeFormat('ko-KR', { hour: '2-digit', minute: '2-digit' }).format(new Date());
					saveStatus.textContent = `이 브라우저에 저장됨 · ${time}`;
					return true;
				} catch {
					saveStatus.textContent = '자동 저장 실패 · 브라우저 저장 공간을 확인하고 파일을 다운로드해 주세요.';
					return false;
				}
			}
			function saveCurrent() {
				if (loading) return;
				clearTimeout(saveTimer);
				const item = currentDraft();
				item.post = readPost();
				item.updatedAt = new Date().toISOString();
				persist();
				renderList();
			}
			function queueSave() {
				if (loading) return;
				preview();
				saveStatus.textContent = '저장 중…';
				clearTimeout(saveTimer);
				saveTimer = setTimeout(saveCurrent, 300);
			}
			try {
				const stored = JSON.parse(localStorage.getItem(storageKey) || 'null');
				if (stored && Array.isArray(stored.drafts) && stored.drafts.length) {
					workspace = stored;
				} else {
					const old = JSON.parse(localStorage.getItem(oldStorageKey) || 'null');
					const first = newDraft(old && typeof old === 'object' ? { ...emptyPost(), ...old } : emptyPost());
					workspace = { activeId: first.id, drafts: [first] };
					if (persist()) localStorage.removeItem(oldStorageKey);
				}
			} catch {
				const first = newDraft();
				workspace = { activeId: first.id, drafts: [first] };
				saveStatus.textContent = '브라우저 저장 데이터를 읽지 못했습니다. 파일로 백업해 주세요.';
			}
			showDraft(workspace.drafts.find((item) => item.id === workspace.activeId) || workspace.drafts[0]);
			if (saveStatus.textContent === '저장 상태 확인 중…') persist();

			form.addEventListener('input', queueSave);
			form.addEventListener('change', (event) => {
				if (event.target !== list && event.target !== fileInput && event.target !== imageInput) queueSave();
			});
			list.addEventListener('change', () => {
				const selectedId = list.value;
				saveCurrent();
				const next = workspace.drafts.find((item) => item.id === selectedId);
				if (next) { showDraft(next); persist(); status.textContent = ''; }
			});
			get('new-post').addEventListener('click', () => {
				saveCurrent();
				const item = newDraft();
				workspace.drafts.push(item);
				showDraft(item);
				persist();
				status.textContent = '';
				(get('title') as HTMLInputElement).focus();
			});
			get('delete-post').addEventListener('click', () => {
				const item = currentDraft();
				if (!confirm(`“${item.post.title || '제목 없는 글'}”을 이 브라우저에서 삭제할까요?`)) return;
				clearTimeout(saveTimer);
				imagePreviews.get(item.id)?.forEach((url) => URL.revokeObjectURL(url));
				imagePreviews.delete(item.id);
				workspace.drafts = workspace.drafts.filter((draft) => draft.id !== item.id);
				if (!workspace.drafts.length) workspace.drafts.push(newDraft());
				showDraft(workspace.drafts[0]);
				persist();
				status.textContent = '';
			});
			get('import-post').addEventListener('click', () => fileInput.click());
			get('insert-image').addEventListener('click', () => imageInput.click());
			imageInput.addEventListener('change', () => {
				const file = imageInput.files?.[0];
				imageInput.value = '';
				if (!file) return;
				try {
					if (!file.type.startsWith('image/')) throw new Error('그림 파일을 선택해 주세요.');
					const markup = makeImageMarkdown(file.name, import.meta.env.BASE_URL);
					const path = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/images/${encodeURIComponent(file.name)}`;
					const item = currentDraft();
					const images = imagePreviews.get(item.id) || new Map<string, string>();
					const previous = images.get(path);
					if (previous) URL.revokeObjectURL(previous);
					images.set(path, URL.createObjectURL(file));
					imagePreviews.set(item.id, images);
					item.imageFiles = [...new Set([...(item.imageFiles || []), file.name])];
					const start = bodyField.selectionStart;
					const end = bodyField.selectionEnd;
					const before = bodyField.value.slice(0, start);
					const after = bodyField.value.slice(end);
					const prefix = before && !before.endsWith('\n\n') ? (before.endsWith('\n') ? '\n' : '\n\n') : '';
					const suffix = after && !after.startsWith('\n\n') ? (after.startsWith('\n') ? '\n' : '\n\n') : '';
					const insertion = `${prefix}${markup}${suffix}`;
					bodyField.value = `${before}${insertion}${after}`;
					bodyField.focus();
					bodyField.setSelectionRange(start + prefix.length, start + prefix.length + markup.length);
					bodyField.dispatchEvent(new Event('input', { bubbles: true }));
					renderImageList();
					status.textContent = `“${file.name}”을 본문에 넣었습니다. GitHub 그림 폴더에도 원본 파일을 올려주세요.`;
				} catch (error) { status.textContent = (error as Error).message; }
			});
			fileInput.addEventListener('change', async () => {
				const file = fileInput.files?.[0];
				fileInput.value = '';
				if (!file) return;
				try {
					if (!/\.(md|markdown)$/i.test(file.name)) throw new Error('Markdown(.md) 파일을 선택해 주세요.');
					if (file.size > 2_000_000) throw new Error('2MB 이하의 Markdown 파일만 불러올 수 있습니다.');
					const post = parsePost(await file.text()) as Post;
					saveCurrent();
					const item = newDraft(post, file.name);
					workspace.drafts.push(item);
					showDraft(item);
					persist();
					status.textContent = `“${file.name}”을 새 글로 불러왔습니다.`;
				} catch (error) { status.textContent = (error as Error).message; }
			});
			get('download').addEventListener('click', () => {
				try {
					const post = readPost();
					const content = serializePost(post);
					const item = currentDraft();
					if (!item.filename) item.filename = makeFilename(post.title);
					const url = URL.createObjectURL(new Blob([content], { type: 'text/markdown;charset=utf-8' }));
					const anchor = document.createElement('a');
					anchor.href = url;
					anchor.download = item.filename;
					anchor.click();
					setTimeout(() => URL.revokeObjectURL(url), 1000);
					saveCurrent();
					preview();
					status.textContent = 'Markdown 파일을 다운로드했습니다. 아래 링크에서 GitHub에 업로드해 주세요.';
				} catch (error) { status.textContent = (error as Error).message; }
			});
			form.addEventListener('submit', (event) => event.preventDefault());
			window.addEventListener('pagehide', () => {
				if (saveTimer) saveCurrent();
				imagePreviews.forEach((images) => images.forEach((url) => URL.revokeObjectURL(url)));
			});
		</script>
	</body>
</html>

<style>
	.editor-page {
		padding-block: 56px 72px;
	}
	.editor-heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 20px;
		margin-bottom: 32px;
	}
	.editor-heading .eyebrow {
		margin-bottom: 12px;
	}
	.editor-heading h1 {
		font-size: 36px;
		margin-bottom: 10px;
	}
	.editor-heading p:last-child {
		color: var(--text-muted);
		margin: 0;
	}
	.editor-layout {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: 24px;
		align-items: start;
	}
	.editor-fields,
	.draft-manager,
	.editor-preview,
	.editor-publish,
	.upload-guide {
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 12px;
		padding: 24px;
	}
	.draft-manager {
		grid-column: 1 / -1;
		display: flex;
		align-items: end;
		gap: 16px;
		flex-wrap: wrap;
	}
	.draft-picker {
		flex: 1 1 230px;
	}
	.draft-picker label {
		display: block;
		font-size: 13px;
		font-weight: 650;
		margin-bottom: 6px;
	}
	.draft-picker select {
		width: 100%;
		min-height: 42px;
		padding: 8px 12px;
		border: 1px solid var(--border);
		border-radius: 6px;
		background: var(--bg);
		color: var(--text);
	}
	.draft-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}
	.draft-actions button {
		min-height: 42px;
		padding: 7px 12px;
		border: 1px solid var(--border);
		border-radius: 6px;
		background: var(--bg);
		color: var(--text);
		cursor: pointer;
	}
	.draft-actions button:hover {
		border-color: var(--accent-2);
	}
	.draft-actions .delete-button {
		color: var(--text-muted);
	}
	#save-status {
		flex-basis: 100%;
		font-size: 12px;
		color: var(--text-muted);
		margin: 0;
	}
	.editor-fields {
		display: grid;
		gap: 18px;
	}
	.editor-fields label {
		display: block;
		font-size: 14px;
		font-weight: 650;
	}
