---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead
			title="글쓰기 | VoidSpace0x"
			description="VoidSpace0x 블로그 글쓰기"
		/>
		<meta name="robots" content="noindex, nofollow" />
		<meta
			http-equiv="Content-Security-Policy"
			content="default-src 'self'; script-src 'self'; connect-src 'self'; img-src 'self' https: data:; style-src 'self' https://cdn.jsdelivr.net; font-src 'self' https://cdn.jsdelivr.net; object-src 'none'; base-uri 'self'; form-action 'none'"
		/>
	</head>
	<body>
		<Header />
		<main id="main-content" tabindex="-1" class="container editor-page">
			<div class="editor-heading">
				<div>
					<p class="eyebrow">NEW RECORD</p>
					<h1>
						새 글 쓰기<span class="heading-dot">.</span>
					</h1>
					<p>글을 작성하고 미리 본 뒤 Markdown 파일로 내려받으세요.</p>
				</div>
				<a href={`${base}/blog/`} class="text-link">
					전체 글 보기 →
				</a>
			</div>
			<form id="post-form" class="editor-layout">
				<div class="editor-fields">
					<div class="field-grid">
						<label>
							제목{' '}
							<input
								id="title"
								name="title"
								type="text"
								maxlength="160"
								required
								placeholder="글 제목"
							/>
						</label>
						<div class="filename-field">
							<span>저장 파일 이름</span>
							<output id="filename-preview" aria-live="polite">
								YYYY-MM-DD-HHmm-제목.md
							</output>
						</div>
					</div>
					<label>
						요약{' '}
						<input
							id="description"
							name="description"
							type="text"
							maxlength="300"
							required
							placeholder="목록에 표시할 한두 문장"
						/>
					</label>
					<div class="field-grid">
						<label>
							카테고리{' '}
							<select id="category" name="category">
								<option value="chat">잡담</option>
								<option value="dev">개발</option>
								<option value="stock">주식</option>
							</select>
						</label>
						<label>
							게시일 <input id="pubDate" name="pubDate" type="date" required />
						</label>
					</div>
					<label class="body-label" for="body">
						본문 <span class="field-hint">Markdown</span>
					</label>
					<textarea
						id="body"
						name="body"
						rows="20"
						required
						placeholder="## 첫 번째 이야기&#10;&#10;여기에 글을 써 주세요."
					></textarea>
					<p class="editor-tip">
						파일 이름은 저장할 때의 한국 날짜·시간과 제목에서 자동 생성됩니다. 글은
						이 브라우저에 임시 저장됩니다. 이미지는 GitHub 저장소에 추가한 뒤
						Markdown 경로로 연결하세요.
					</p>
				</div>
				<aside class="editor-preview" aria-label="글 미리보기">
					<div class="preview-header">
						<strong>미리보기</strong>
						<span>PREVIEW</span>
					</div>
					<article id="preview-article" data-category="chat">
						<p id="preview-category" class="category-badge">
							잡담
						</p>
						<h2 id="preview-title">제목을 입력해 주세요</h2>
						<p id="preview-description" class="preview-description">
							요약이 여기에 표시됩니다.
						</p>
						<div id="preview-body" class="prose">
							본문을 입력하면 미리보기가 표시됩니다.
						</div>
					</article>
				</aside>
				<div class="editor-publish">
					<div class="publish-copy">
						<label for="draft" class="draft-option">
							<input id="draft" name="draft" type="checkbox" /> 초안으로 저장
						</label>
						<p>초안으로 저장한 파일은 업로드해도 블로그에 표시되지 않습니다.</p>
					</div>
					<div class="publish-actions">
						<button type="button" id="download" class="button">
							Markdown 파일 다운로드
						</button>
					</div>
				</div>
				<section class="upload-guide" aria-label="GitHub 업로드 방법">
					<strong>블로그에 올리는 방법</strong>
					<ol>
						<li>위 버튼으로 <code>.md</code> 파일을 다운로드합니다.</li>
						<li>
							<a href="https://github.com/voidspace0x/blog/upload/main/src/content/blog" target="_blank" rel="noopener noreferrer">GitHub 글 업로드 화면 열기 ↗</a>에서 다운로드한 파일을 선택합니다. GitHub 로그인이 필요합니다.
						</li>
						<li><strong>Commit changes</strong>를 누르면 저장됩니다. 공개 글은 배포가 끝난 뒤 블로그에 나타납니다.</li>
					</ol>
				</section>
				<p
					id="editor-status"
					class="editor-status"
					role="status"
					aria-live="polite"
				></p>
			</form>
		</main>
		<Footer />
		<script>
			import { marked } from 'marked';
			import DOMPurify from 'dompurify';
			import {
				makeFilename,
				serializePost,
			} from '../lib/editor.mjs';
			import { CATEGORY_LABELS } from '../consts';

			const get = (id: string) => document.getElementById(id) as HTMLElement;
			const form = get('post-form') as HTMLFormElement;
			const title = get('title') as HTMLInputElement;
			const draft = get('draft') as HTMLInputElement;
			const status = get('editor-status');
			const storageKey = 'voidspace0x-blog-editor-draft-v1';

			function readPost() {
				const data = new FormData(form);
				return {
					title: String(data.get('title') ?? ''),
					description: String(data.get('description') ?? ''),
					category: String(data.get('category') ?? ''),
					pubDate: String(data.get('pubDate') ?? ''),
					body: String(data.get('body') ?? ''),
					draft: draft.checked,
				};
			}

			function preview() {
				const post = readPost();
				try {
					get('filename-preview').textContent = makeFilename(
						post.title || '제목',
					);
				} catch {
					get('filename-preview').textContent =
						'제목에 글자나 숫자를 입력해 주세요.';
				}
				get('preview-title').textContent = post.title || '제목을 입력해 주세요';
				get('preview-description').textContent =
					post.description || '요약이 여기에 표시됩니다.';
				get('preview-category').textContent =
					CATEGORY_LABELS[post.category as keyof typeof CATEGORY_LABELS] ||
					'잡담';
				get('preview-article').dataset.category = post.category;
				const html = marked.parse(
					post.body || '본문을 입력하면 미리보기가 표시됩니다.',
					{ async: false },
				) as string;
				get('preview-body').innerHTML = DOMPurify.sanitize(html, {
					FORBID_TAGS: ['iframe', 'form', 'style'],
				});
				get('preview-body')
					.querySelectorAll('a')
					.forEach((link) => {
						link.target = '_blank';
						link.rel = 'noopener noreferrer';
					});
				try {
					localStorage.setItem(storageKey, JSON.stringify(post));
				} catch {
					/* private browsing */
				}
			}

			try {
				const saved = JSON.parse(localStorage.getItem(storageKey) || 'null');
				if (saved) {
					for (const key of [
						'title',
						'description',
						'category',
						'pubDate',
						'body',
					]) {
						const field = form.elements.namedItem(key) as
							HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null;
						if (field && typeof saved[key] === 'string')
							field.value = saved[key];
					}
					draft.checked = Boolean(saved.draft);
				}
			} catch {
				/* invalid local data */
			}
			if (!(get('pubDate') as HTMLInputElement).value) {
				(get('pubDate') as HTMLInputElement).value = new Intl.DateTimeFormat(
					'en-CA',
					{
						timeZone: 'Asia/Seoul',
						year: 'numeric',
						month: '2-digit',
						day: '2-digit',
					},
				).format(new Date());
			}
			preview();

			form.addEventListener('input', preview);
			form.addEventListener('change', preview);
			get('download').addEventListener('click', () => {
				try {
					const post = readPost();
					const url = URL.createObjectURL(
						new Blob([serializePost(post)], {
							type: 'text/markdown;charset=utf-8',
						}),
					);
					const anchor = document.createElement('a');
					anchor.href = url;
					anchor.download = makeFilename(post.title);
					anchor.click();
					setTimeout(() => URL.revokeObjectURL(url), 1000);
					status.textContent = 'Markdown 파일을 다운로드했습니다. 아래 링크에서 GitHub에 업로드해 주세요.';
				} catch (error) {
					status.textContent = (error as Error).message;
				}
			});
			form.addEventListener('submit', (event) => event.preventDefault());
		</script>
	</body>
</html>

<style>
	.editor-page {
		padding-block: 56px 72px;
	}
	.editor-heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 20px;
		margin-bottom: 32px;
	}
	.editor-heading .eyebrow {
		margin-bottom: 12px;
	}
	.editor-heading h1 {
		font-size: 36px;
		margin-bottom: 10px;
	}
	.editor-heading p:last-child {
		color: var(--text-muted);
		margin: 0;
	}
	.editor-layout {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: 24px;
		align-items: start;
	}
	.editor-fields,
	.editor-preview,
	.editor-publish,
	.upload-guide {
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 12px;
		padding: 24px;
	}
	.editor-fields {
		display: grid;
		gap: 18px;
	}
	.editor-fields label {
		display: block;
		font-size: 14px;
		font-weight: 650;
	}
	.field-hint {
		color: var(--text-muted);
		font-size: 12px;
		font-weight: 400;
	}
	.filename-field {
		min-width: 0;
		font-size: 14px;
		font-weight: 650;
	}
	.filename-field output {
		display: block;
		margin-top: 8px;
		padding: 10px 12px;
		min-height: 45px;
		border: 1px solid var(--border);
		border-radius: 6px;
		background: var(--bg);
		color: var(--text-muted);
		font-size: 13px;
		font-weight: 400;
		overflow-wrap: anywhere;
	}
	.field-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 16px;
	}
	.editor-fields input,
	.editor-fields select,
	.editor-fields textarea {
		display: block;
		width: 100%;
		margin-top: 8px;
		border: 1px solid var(--border);
		border-radius: 6px;
		background: var(--bg);
		color: var(--text);
		padding: 10px 12px;
		outline: none;
	}
	.editor-fields input:focus,
	.editor-fields select:focus,
	.editor-fields textarea:focus {
		border-color: var(--focus-ring);
		box-shadow: 0 0 0 1px var(--focus-ring);
	}
	.editor-fields textarea {
		min-height: 400px;
		resize: vertical;
		font-family: 'JetBrains Mono', monospace;
		font-size: 14px;
		line-height: 1.7;
		tab-size: 2;
	}
	.editor-tip {
		color: var(--text-muted);
		font-size: 12px;
		margin: 0;
	}
	.editor-preview {
		position: sticky;
		top: 20px;
		max-height: min(80vh, 900px);
		overflow: auto;
	}
	.preview-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		border-bottom: 1px solid var(--border);
		padding-bottom: 16px;
		margin-bottom: 24px;
		font-size: 14px;
	}
	.preview-header span {
		color: var(--text-muted);
		font-family: 'JetBrains Mono', monospace;
		font-size: 10px;
		letter-spacing: 0.12em;
	}
	.editor-preview h2 {
		font-size: 28px;
		margin: 16px 0 10px;
	}
	.preview-description {
		color: var(--text-muted);
		border-bottom: 1px solid var(--border);
		padding-bottom: 20px;
	}
	.editor-preview .prose {
		font-size: 16px;
		overflow-wrap: anywhere;
	}
	.editor-preview .prose :global(h2) {
		font-size: 22px;
	}
	.editor-preview .prose :global(h3) {
		font-size: 19px;
	}
	.editor-preview .prose :global(pre),
	.editor-preview .prose :global(table) {
		max-width: 100%;
		overflow-x: auto;
	}
	.editor-publish {
		grid-column: 1 / -1;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 20px;
	}
	.upload-guide {
		grid-column: 1 / -1;
		color: var(--text-muted);
		font-size: 14px;
	}
	.upload-guide strong {
		color: var(--text);
	}
	.upload-guide ol {
		padding-left: 24px;
		margin: 12px 0 0;
	}
	.upload-guide li + li {
		margin-top: 8px;
	}
	.draft-option {
		display: flex;
		align-items: center;
		gap: 10px;
		font-weight: 650;
		cursor: pointer;
	}
	.draft-option input {
		width: 18px;
		height: 18px;
		accent-color: var(--accent-2);
	}
	.publish-copy p {
		margin: 4px 0 0;
		color: var(--text-muted);
		font-size: 12px;
	}
	.publish-actions {
		display: flex;
		gap: 12px;
		flex-wrap: wrap;
	}
	.editor-status {
		grid-column: 1 / -1;
		margin: 0;
		color: var(--accent-2);
		font-size: 14px;
	}
	.editor-status:empty {
		display: none;
	}
	@media (max-width: 840px) {
		.editor-layout {
			grid-template-columns: 1fr;
		}
		.editor-preview {
			position: static;
			max-height: 450px;
		}
		.editor-heading {
			align-items: start;
		}
	}
	@media (max-width: 600px) {
		.editor-page {
			padding-block: 32px 48px;
		}
		.editor-heading {
			display: block;
		}
		.editor-heading h1 {
			font-size: 28px;
		}
		.field-grid {
			grid-template-columns: 1fr;
		}
		.editor-fields,
		.editor-preview,
		.editor-publish,
		.upload-guide {
			padding: 20px;
		}
		.editor-publish {
			align-items: stretch;
			flex-direction: column;
		}
		.publish-actions > button {
			flex: 1;
		}
	}
</style>
