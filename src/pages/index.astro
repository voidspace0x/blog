---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PostCard from '../components/PostCard.astro';
import CategoryNav from '../components/CategoryNav.astro';
import { SITE_DESCRIPTION } from '../consts';
import { getPosts } from '../lib/posts';
const posts = await getPosts();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead
			title="VoidSpace0x — 공허를 떠도는 기록들"
			description={SITE_DESCRIPTION}
		/>
	</head>
	<body>
		<Header />
		<main id="main-content" tabindex="-1" class="container">
			<section class="hero">
				<div class="hero-copy">
					<p class="eyebrow">
						<span></span> A PERSONAL SPACE
					</p>
					<h1>
						공허를 떠도는
						<br />
						<span class="accent-text">기록들.</span>
					</h1>
					<p class="hero-description">
						개발하며 배운 것, 시장을 보며 든 생각,
						<br class="desktop-break" /> 그리고 일상의 작은 메모를 남깁니다.
					</p>
					<div class="hero-actions">
						<a class="button" href={`${base}/blog/`}>
							전체 글 보기 <span aria-hidden="true">↗</span>
						</a>
						<a class="text-link" href={`${base}/about`}>
							이 공간에 대해 <span aria-hidden="true">→</span>
						</a>
					</div>
				</div>
				<div class="orbit-art" aria-hidden="true">
					<img class="orbit-illustration" src={`${base}/images/brand/void-hero.webp`} width="240" height="240" alt="" fetchpriority="high" />
					<span class="orbit-caption">A QUIET SPACE FOR THOUGHTS</span>
				</div>
			</section>
			<section class="recent-section" aria-labelledby="recent-title">
				<div class="section-heading">
					<h2 id="recent-title">
						최근 기록{' '}
						<span class="section-index">
							/ {String(posts.length).padStart(2, '0')}
						</span>
					</h2>
					<a class="text-link" href={`${base}/blog/`}>
						전체 글 보기 <span aria-hidden="true">→</span>
					</a>
				</div>
				<CategoryNav posts={posts} />
				<ul class="post-list">
					{posts.slice(0, 6).map((post) => (
						<PostCard post={post} heading="h3" />
					))}
				</ul>
				{posts.length === 0 && <p class="empty-state">아직 기록이 없습니다.</p>}
			</section>
		</main>
		<Footer />
	</body>
</html>
