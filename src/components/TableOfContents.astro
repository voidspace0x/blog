---
import type { MarkdownHeading } from 'astro';
interface Props {
	headings: MarkdownHeading[];
}
const { headings } = Astro.props;
const items = headings.filter((h) => h.depth === 2);
---

{items.length >= 4 && (
	<details class="table-of-contents">
		<summary>
			이 글의 내용 <span>{items.length}개의 이야기</span>
		</summary>
		<nav aria-label="목차">
			<ol>
				{items.map((item) => (
					<li>
						<a href={`#${item.slug}`}>{item.text}</a>
					</li>
				))}
			</ol>
		</nav>
	</details>
)}
