---
interface Props {
	date: Date;
}
const { date } = Astro.props;
const formatted = new Intl.DateTimeFormat('ko-KR', {
	year: 'numeric',
	month: '2-digit',
	day: '2-digit',
	timeZone: 'UTC',
})
	.format(date)
	.replace(/\. /g, '.')
	.replace(/\.$/, '');
---

<time datetime={date.toISOString()}>{formatted}</time>
