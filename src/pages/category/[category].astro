---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PostCard from '../../components/PostCard.astro';
import CategoryNav from '../../components/CategoryNav.astro';
import {
	CATEGORY_LABELS,
	CATEGORY_DESCRIPTIONS,
	type Category,
} from '../../consts';
import { getPosts } from '../../lib/posts';
export function getStaticPaths() {
	return Object.keys(CATEGORY_LABELS).map((category) => ({
		params: { category },
	}));
}
const { category } = Astro.params as { category: Category };
const posts = await getPosts();
const filtered = posts.filter((p) => p.data.category === category);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead
			title={`${CATEGORY_LABELS[category]} | VoidSpace0x`}
			description={CATEGORY_DESCRIPTIONS[category]}
		/>
	</head>
	<body>
		<Header />
		<main
			id="main-content"
			tabindex="-1"
			class="container listing-page"
			data-category={category}
		>
			<div class="page-heading">
				<p class="eyebrow">
					{category.toUpperCase()} / {String(filtered.length).padStart(2, '0')}{' '}
					RECORDS
				</p>
				<h1>
					{CATEGORY_LABELS[category]}
					<span class="heading-dot">.</span>
				</h1>
				<p>{CATEGORY_DESCRIPTIONS[category]}</p>
			</div>
			<CategoryNav posts={posts} current={category} />
			<ul class="post-list">
				{filtered.map((post) => (
					<PostCard post={post} />
				))}
			</ul>
			{filtered.length === 0 && (
				<div class="empty-state">
					<p>아직 기록이 없습니다.</p>
					<a href={`${base}/blog/`}>전체 글 보기 →</a>
				</div>
			)}
		</main>
		<Footer />
	</body>
</html>
